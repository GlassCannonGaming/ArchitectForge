rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // 1. GLOBAL SAFETY NET (Default-Deny Catch-All)
    // =========================================================================
    match /{document=**} {
      allow read, write: if false;
    }

    // =========================================================================
    // 2. HARDENED PRIMITIVE HELPERS
    // =========================================================================
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // =========================================================================
    // 3. ENTITY VALIDATION BLUEPRINTS (Anti-Update-Gap)
    // =========================================================================
    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'displayName', 'activeProjectId', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'activeProjectId', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid == userId && data.uid == request.auth.uid
        && isValidId(data.uid)
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80
        && data.activeProjectId is string && isValidId(data.activeProjectId)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCloudProject(data, projectId) {
      return data.keys().hasAll([
          'projectId',
          'ownerId',
          'name',
          'description',
          'currentFloor',
          'gameTimeMinutes',
          'floorsCount',
          'assetsCount',
          'blueprintsCount',
          'charactersCount',
          'workspaceState',
          'status',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'projectId',
          'ownerId',
          'name',
          'description',
          'currentFloor',
          'gameTimeMinutes',
          'floorsCount',
          'assetsCount',
          'blueprintsCount',
          'charactersCount',
          'workspaceState',
          'status',
          'createdAt',
          'updatedAt'
        ])
        && data.projectId is string && data.projectId == projectId && isValidId(data.projectId)
        && data.ownerId is string && data.ownerId == request.auth.uid && isValidId(data.ownerId)
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 120
        && data.description is string && data.description.size() >= 0 && data.description.size() <= 500
        && data.currentFloor is string && data.currentFloor.size() >= 1 && data.currentFloor.size() <= 64
        && data.gameTimeMinutes is int && data.gameTimeMinutes >= 0 && data.gameTimeMinutes <= 1440
        && data.floorsCount is int && data.floorsCount >= 1 && data.floorsCount <= 32
        && data.assetsCount is int && data.assetsCount >= 0 && data.assetsCount <= 5000
        && data.blueprintsCount is int && data.blueprintsCount >= 0 && data.blueprintsCount <= 500
        && data.charactersCount is int && data.charactersCount >= 0 && data.charactersCount <= 200
        && data.workspaceState is map && data.workspaceState.size() >= 1 && data.workspaceState.size() <= 20
        && data.status is string && (data.status == 'active' || data.status == 'archived')
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCloudAudioPreset(data, projectId, presetId) {
      return data.keys().hasAll([
          'presetId',
          'projectId',
          'ownerId',
          'name',
          'category',
          'modelUsed',
          'parameters',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'presetId',
          'projectId',
          'ownerId',
          'name',
          'category',
          'modelUsed',
          'parameters',
          'createdAt',
          'updatedAt'
        ])
        && data.presetId is string && data.presetId == presetId && isValidId(data.presetId)
        && data.projectId is string && data.projectId == projectId && isValidId(data.projectId)
        && data.ownerId is string && data.ownerId == request.auth.uid && isValidId(data.ownerId)
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 80
        && data.category is string && (data.category == 'sfx' || data.category == 'bgm')
        && data.modelUsed is string && data.modelUsed == 'gemini-3.1-flash-lite'
        && data.parameters is map && data.parameters.size() >= 1 && data.parameters.size() <= 30
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Master Gate helper for subcollections under /projects/{projectId}
    function isParentProjectOwner(projectId) {
      return exists(/databases/$(database)/documents/projects/$(projectId))
        && get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId == request.auth.uid;
    }

    // =========================================================================
    // 4. COLLECTION RULES
    // =========================================================================

    // 4A. User Profiles (/users/{userId})
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;

      allow create: if isVerifiedUser()
        && isOwner(userId)
        && isValidId(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerifiedUser()
        && isValidUserProfile(incoming(), userId)
        && isOwner(userId)
        && isValidId(userId)
        && existing().uid == request.auth.uid
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          // Action: Update Profile Display Name or Active Project Pointer
          incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'activeProjectId', 'updatedAt'])
        );

      allow delete: if isVerifiedUser()
        && isOwner(userId)
        && isValidId(userId)
        && existing().uid == request.auth.uid;
    }

    // 4B. Cloud Studio Projects (/projects/{projectId})
    match /projects/{projectId} {
      allow get: if isSignedIn()
        && isValidId(projectId)
        && existing().ownerId == request.auth.uid;

      // Query Enforcer: forces client where('ownerId', '==', uid) without get()/exists() cost explosion
      allow list: if isSignedIn()
        && resource.data.ownerId == request.auth.uid;

      allow create: if isVerifiedUser()
        && isValidId(projectId)
        && isValidCloudProject(incoming(), projectId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && incoming().status == 'active';

      allow update: if isVerifiedUser()
        && isValidCloudProject(incoming(), projectId)
        && isValidId(projectId)
        && existing().ownerId == request.auth.uid
        && incoming().ownerId == existing().ownerId
        && incoming().projectId == existing().projectId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && existing().status != 'archived'
        && (
          // Action 1: Sync Workspace State & Metadata
          (incoming().status == 'active'
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'name',
              'description',
              'currentFloor',
              'gameTimeMinutes',
              'floorsCount',
              'assetsCount',
              'blueprintsCount',
              'charactersCount',
              'workspaceState',
              'updatedAt'
            ]))
          ||
          // Action 2: Archive Project (Terminal State Transition)
          (incoming().status == 'archived'
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']))
        );

      allow delete: if isVerifiedUser()
        && isValidId(projectId)
        && existing().ownerId == request.auth.uid;

      // 4C. Subcollection: Cloud Audio Presets (/projects/{projectId}/audioPresets/{presetId})
      match /audioPresets/{presetId} {
        allow get: if isSignedIn()
          && isValidId(projectId)
          && isValidId(presetId)
          && existing().ownerId == request.auth.uid
          && isParentProjectOwner(projectId);

        allow list: if isSignedIn()
          && resource.data.ownerId == request.auth.uid;

        allow create: if isVerifiedUser()
          && isValidId(projectId)
          && isValidId(presetId)
          && isValidCloudAudioPreset(incoming(), projectId, presetId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && isParentProjectOwner(projectId);

        allow update: if isVerifiedUser()
          && isValidCloudAudioPreset(incoming(), projectId, presetId)
          && isValidId(projectId)
          && isValidId(presetId)
          && existing().ownerId == request.auth.uid
          && incoming().ownerId == existing().ownerId
          && incoming().projectId == existing().projectId
          && incoming().presetId == existing().presetId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && isParentProjectOwner(projectId)
          && (
            // Action: Update Audio Synthesis Parameters or Name
            incoming().diff(existing()).affectedKeys().hasOnly(['name', 'parameters', 'updatedAt'])
          );

        allow delete: if isVerifiedUser()
          && isValidId(projectId)
          && isValidId(presetId)
          && existing().ownerId == request.auth.uid
          && isParentProjectOwner(projectId);
      }
    }
  }
}
